if myshell_module_enabled "docker/jira-software"; then
	alias jira_software="bash $project_path/modules/docker/jira-software/jira-software.bash"
	alias jira_software_cero_exec="bash $project_path/modules/docker/jira-software/jira-software_cero_exec.bash"
	alias jira_software_uno_exec="bash $project_path/modules/docker/jira-software/jira-software_uno_exec.bash"
fi
if myshell_module_enabled "docker/nodejs"; then
	alias nodejs="bash $project_path/modules/docker/nodejs/nodejs.bash"
	alias nodejs_exec="bash $project_path/modules/docker/nodejs/nodejs_exec.bash"
fi
if myshell_module_enabled "docker/nginx"; then
	alias nginx="bash $project_path/modules/docker/nginx/nginx.bash"
	alias nginx_exec="bash $project_path/modules/docker/nginx/nginx_exec.bash"
fi
myshell_module_enabled "docker/k6" && alias k6="bash $project_path/modules/docker/k6/k6.bash"

# John the Ripper
myshell_module_enabled "john/dictionary" && alias john_dictionary="bash $project_path/modules/john/dictionary/dictionary.bash"
myshell_module_enabled "john/unshadow" && alias john_unshadow="bash $project_path/modules/john/unshadow/unshadow.bash"
myshell_module_enabled "john/zip" && alias john_zip="bash $project_path/modules/john/zip/zip.bash"

# Utilities
myshell_module_enabled "utils/ssl" && alias check_domains="bash $project_path/modules/utils/ssl/ssl_check.bash"
myshell_module_enabled "utils/certs" && alias cert_base64_for_sealed_secret="bash $project_path/modules/utils/certs/cert_base64_for_sealed_secret.bash"
myshell_module_enabled "utils/linux_scripts" && alias format_disk_ext4="bash $project_path/modules/utils/linux_scripts/format_disk_ext4.bash"

# GitHub token management (multi-repo). Store: ~/.config/gh/repo_tokens
if myshell_module_enabled "utils/gh-tokens"; then
	alias gh_tokens="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash menu"
	alias gh_create="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash create"
	alias gh_status="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash status"
	alias gh_rotate="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash rotate"
	alias gh_git="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash git"
	alias gh_switch="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash switch"
	alias gh_revoke="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash revoke"
	alias gh_init="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash init"
	alias gh_help="bash $project_path/modules/utils/gh-tokens/gh_tokens.bash help"
fi

# yt-dlp
myshell_module_enabled "yt-dlp" && alias download="bash $project_path/modules/yt-dlp/yt-dlp.bash"
