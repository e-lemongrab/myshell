#!/bin/bash
# Module commands are exposed by default. Individual scripts remain responsible
# for reporting missing runtime dependencies when they are invoked.
# shellcheck disable=SC2139

# Paths consumed by module scripts.
export mod_colors="$project_path/core/shells/bash/functions/colors.bash"
export ssl_functions="$project_path/modules/utils/ssl/functions.bash"
export certs_functions="$project_path/modules/utils/certs/functions.bash"

# Base shell
alias cls="clear"
alias c="code ."
alias free="free -mh"
alias grep="grep --color=auto"
alias ls="ls -lah --color"
alias nano="nano -l"
alias h="history"
alias e="exit"
alias reload_shell='exec -l "$SHELL"'
alias clear_ram="sudo bash -c 'echo 1 > /proc/sys/vm/drop_caches'"
alias cat_input='read -r input; grep -r --exclude-dir=".*" -- "$input" .'

# tmux
alias tmuxon="tmux new -s docker -d&tmux new -s cloud -d&tmux new -s ssh -d&tmux new -s codex -d&"
alias tmuxls="tmux ls"
alias tmuxattach="tmux a -t"

# Terraform
myshell_terraform_init_upgrade() {
	printf 'Terraform will remove these local initialization artifacts:\n'
	for target in .terraform .terraform.lock.hcl; do
		[ -e "$target" ] && printf '  %s\n' "$PWD/$target"
	done
	printf 'Continue and run terraform init --upgrade? Type YES: '
	read -r confirmation
	[ "$confirmation" = "YES" ] || {
		printf 'Cancelled.\n'
		return 1
	}
	rm -rf -- .terraform .terraform.lock.hcl
	terraform init --upgrade
}
alias tfi="myshell_terraform_init_upgrade"
alias tfp="terraform plan "
alias tff="terraform fmt"
alias tfa="terraform apply "

# Bitwarden
if myshell_module_enabled "bw"; then
	alias bw="$HOME/'.config/Bitwarden CLI/bw'"
	alias bw_eu="bw config server https://vault.bitwarden.eu"
	alias bw_create="bash $project_path/modules/bw/bw-history-create.bash"
	alias bw_push="bash $project_path/modules/bw/bw-history-push.bash"
	alias bw_clone="bash $project_path/modules/bw/bw-history-clone.bash"
fi

# Git
if myshell_module_enabled "utils/git"; then
	myshell_git_hard_reset() {
		git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
			printf 'Not inside a Git repository.\n' >&2
			return 1
		}
		printf 'Current changes:\n'
		git status --short
		printf '\nCommit that will be removed from the current branch:\n'
		git log -1 --oneline --decorate HEAD
		printf '\nRun git reset --hard HEAD~1? Type YES: '
		read -r confirmation
		[ "$confirmation" = "YES" ] || {
			printf 'Cancelled.\n'
			return 1
		}
		git reset --hard HEAD~1
	}
	alias gp="git pull"
	alias gpush="git push"
	alias gs="git status"
	alias gl="git log"
	alias gc="git log --branches --not --remotes"
	alias gsoft="git reset --soft HEAD~1"
	alias ghard="myshell_git_hard_reset"
	alias gpr="gh pr list"
fi

# Help
myshell_module_enabled "help/arch" && alias help_arch="bash $project_path/modules/help/arch/arch.bash"
myshell_module_enabled "help/az" && alias help_az="bash $project_path/modules/help/az/az.bash"
myshell_module_enabled "help/dig" && alias help_dig="bash $project_path/modules/help/dig/dig.bash"
myshell_module_enabled "help/docker" && alias help_docker="bash $project_path/modules/help/docker/docker.bash"
myshell_module_enabled "help/gcloud" && alias help_gcloud="bash $project_path/modules/help/gcloud/gcloud.bash"
myshell_module_enabled "help/git" && alias help_git="bash $project_path/modules/help/git/git.bash"
myshell_module_enabled "help/kubectl" && alias help_kubectl="bash $project_path/modules/help/kubectl/kubectl.bash"
myshell_module_enabled "help/mysql" && alias help_mysql="bash $project_path/modules/help/mysql/mysql.bash"
myshell_module_enabled "help/terraform" && alias help_terraform="bash $project_path/modules/help/terraform/terraform.bash"

# Docker
myshell_module_enabled "docker/dock" && alias dockrm="bash $project_path/modules/docker/dock/dockrm.bash"
if myshell_module_enabled "docker/alpine"; then
	alias alpine="bash $project_path/modules/docker/alpine/alpine.bash"
