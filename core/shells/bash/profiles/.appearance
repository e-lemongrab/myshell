#!/bin/bash
# Modify ls colors
export LS_COLORS='rs=0:di=01;30;42:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:mi=00:su=37;41:sg=30;43:ca=00:tw=30;42:ow=34;42:st=37;44:ex=01;30;103:*.tar=01;31:*.tgz=01;31:*.arc=01;31:*.arj=01;31:*.taz=01;31:*.lha=01;31:*.lz4=01;31:*.lzh=01;31:*.lzma=01;31:*.tlz=01;31:*.txz=01;31:*.tzo=01;31:*.t7z=01;31:*.zip=01;31:*.z=01;31:*.dz=01;31:*.gz=01;31:*.lrz=01;31:*.lz=01;31:*.lzo=01;31:*.xz=01;30;105:*.zst=01;31:*.tzst=01;31:*.bz2=01;31:*.bz=01;31:*.tbz=01;31:*.tbz2=01;31:*.tz=01;31:*.deb=01;31:*.rpm=01;31:*.jar=01;31:*.war=01;31:*.ear=01;31:*.sar=01;31:*.rar=01;31:*.alz=01;31:*.ace=01;31:*.zoo=01;31:*.cpio=01;31:*.7z=01;31:*.rz=01;31:*.cab=01;31:*.wim=01;31:*.swm=01;31:*.dwm=01;31:*.esd=01;31:*.avif=01;35:*.jpg=01;35:*.jpeg=01;35:*.mjpg=01;35:*.mjpeg=01;35:*.gif=01;35:*.bmp=01;35:*.pbm=01;35:*.pgm=01;35:*.ppm=01;35:*.tga=01;35:*.xbm=01;35:*.xpm=01;35:*.tif=01;35:*.tiff=01;35:*.png=01;35:*.svg=01;35:*.svgz=01;35:*.mng=01;35:*.pcx=01;35:*.mov=01;35:*.mpg=01;35:*.mpeg=01;35:*.m2v=01;35:*.mkv=01;35:*.webm=01;35:*.webp=01;35:*.ogm=01;35:*.mp4=01;35:*.m4v=01;35:*.mp4v=01;35:*.vob=01;35:*.qt=01;35:*.nuv=01;35:*.wmv=01;35:*.asf=01;35:*.rm=01;35:*.rmvb=01;35:*.flc=01;35:*.avi=01;35:*.fli=01;35:*.flv=01;35:*.gl=01;35:*.dl=01;35:*.xcf=01;35:*.xwd=01;35:*.yuv=01;35:*.cgm=01;35:*.emf=01;35:*.ogv=01;35:*.ogx=01;35:*.aac=00;36:*.au=00;36:*.flac=00;36:*.m4a=00;36:*.mid=00;36:*.midi=00;36:*.mka=00;36:*.mp3=00;36:*.mpc=00;36:*.ogg=00;36:*.ra=00;36:*.wav=00;36:*.oga=00;36:*.opus=00;36:*.spx=00;36:*.xspf=00;36:*~=00;90:*#=00;90:*.bak=00;90:*.old=00;90:*.orig=00;90:*.part=00;90:*.rej=00;90:*.swp=00;90:*.tmp=00;90:*.dpkg-dist=00;90:*.dpkg-old=00;90:*.ucf-dist=00;90:*.ucf-new=00;90:*.ucf-old=00;90:*.rpmnew=00;90:*.rpmorig=00;90:*.rpmsave=00;90:'

# Modify grep colors
export GREP_COLORS='ms=01;32:mc=01;32:sl=01;33:cx=01;31:fn=00;32:ln=00;37:bn=00;32:se=00'

# Add an "alert" alias for long running commands.  Use like so:
#   sleep 10; alert
#sudo apt install libnotify-bin
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

## General settings
# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# Resolve the AWS identity once and cache it briefly. This information is only
# used to decorate the prompt; a failed or expired login must not block startup.
role_arn=""
mfa_serial=""
if [ -n "${AWS_PROFILE:-}" ] && command -v aws >/dev/null 2>&1; then
	aws_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/myshell"
	aws_cache_key=$(printf '%s' "$AWS_PROFILE" | tr -c '[:alnum:]_.-' '_')
	aws_cache_file="$aws_cache_root/aws-identity-$aws_cache_key"
	identity_arn=""
	mkdir -p "$aws_cache_root"

	if [ -f "$aws_cache_file" ] &&
		[ "$(($(date +%s) - $(stat -c %Y "$aws_cache_file" 2>/dev/null || printf '0')))" -lt 300 ]; then
		IFS= read -r identity_arn <"$aws_cache_file"
	else
		identity_arn=$(aws sts get-caller-identity --query Arn --output text 2>/dev/null) || identity_arn=""
		if [ -n "$identity_arn" ]; then
			aws_cache_tmp="${aws_cache_file}.tmp.$$"
			printf '%s\n' "$identity_arn" >"$aws_cache_tmp"
			chmod 600 "$aws_cache_tmp"
			mv "$aws_cache_tmp" "$aws_cache_file"
		fi
	fi

	if [ -n "$identity_arn" ]; then
		IFS=/ read -r _ role_arn identity_session <<<"$identity_arn"
		aws_profile_block=""
		if [ -r "$HOME/.aws/config" ]; then
			aws_profile_block=$(sed -n "/^\[profile $AWS_PROFILE\]$/,/^\[/p" "$HOME/.aws/config")
		fi
		if grep -q "sso_session" <<<"$aws_profile_block"; then
			mfa_serial="$identity_session"
		else
			mfa_serial=$(awk -F/ '/^[[:space:]]*mfa_serial[[:space:]]*=/{print $NF; exit}' <<<"$aws_profile_block")
		fi
	fi
	export AWS_ROLE="$role_arn"
fi
unset aws_cache_root aws_cache_key aws_cache_file aws_cache_tmp identity_arn identity_session aws_profile_block


## Color and appearance
# PS1 - prompt
OS_RELEASE=$(sed -n 's/^PRETTY_NAME="\\(.*\\)"/\\1/p' /etc/os-release)
color_prompt=yes
if [ "$color_prompt" = yes ]; then
    PS1='\n\[\033[01;40m\]┌──${debian_chroot:+($debian_chroot)}\[\033[01;33m\]\u@\h:\w$\[\033[01;40m\]\[\033[01;91m\]$(parse_git_branch)\[\033[00m\]\n\[\033[01;40m\]│\[\033[00m\] $(date +%H:%M:%S) | Jobs: \j | $OS_RELEASE | $(basename $SHELL) \V \
${AWS_PROFILE:+\n\[\033[01;36m\]│ [$AWS_PROFILE - Role: $role_arn MFA: $mfa_serial]\[\033[00m\]}\n\
\[\033[01;40m\]└─\[\033[01;91m\]> \[\033[00m\]'
else
    PS1="${debian_chroot:+($debian_chroot)}\u@\h:\w\$"
fi
# colored GCC warnings and errors
#export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'
